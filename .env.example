# ─────────────────────────────────────────────────────────────────────
# Hermes Kate — Environment Variables
# Copy this to .env and fill in your values:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────

# ── LLM Providers (at least one required) ──
OPENROUTER_API_KEY=sk-or-v1-your-key-here
# OpenAI (Codex/GPT-5.5) — optional
OPENAI_API_KEY=sk-your-key-here
# Anthropic (Claude Sonnet/Opus) — optional
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Google (Gemini) — optional
GOOGLE_API_KEY=your-key-here

# ── Messaging ──
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
TELEGRAM_ALLOWED_USERS=your-telegram-user-id
TELEGRAM_HOME_CHANNEL=your-home-channel-id

# ── Voice ──
ELEVENLABS_API_KEY=your-elevenlabs-key

# ── MCP / External APIs (all optional) ──
EPO_OPS_CONSUMER_KEY=your-epo-key
EPO_OPS_CONSUMER_SECRET=your-epo-secret
USPTO_API_KEY=your-uspto-key
CRUNCHBASE_API_KEY=your-crunchbase-key
TAVILY_API_KEY=your-tavily-key
GITHUB_TOKEN=ghp_your-github-token

# ── Intelligence / Market Data (optional) ──
FRED_API_KEY=your-fred-key
ACLED_ACCESS_TOKEN=your-acled-token
NASA_FIRMS_API_KEY=your-firms-key
EIA_API_KEY=your-eia-key
TOMTOM_API_KEY=your-tomtom-key
WINDY_API_KEY=your-windy-key

# ── Cloudflare Tunnel (optional) ──
# Generate: cloudflared tunnel create kate
# Then copy the token from ~/.cloudflared/<uuid>.json
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token

# ── Runtime ──
HERMES_MAX_ITERATIONS=90
PYTHONUNBUFFERED=1

# ── UID/GID mapping for volume permissions ──
# Set these to match your host user if running rootless
HERMES_UID=1000
HERMES_GID=1000

# ── Network fallback (Telegram API IPs) ──
# Useful when DNS-based access is blocked
TELEGRAM_FALLBACK_IPS=149.154.167.220,149.154.166.110,149.154.167.41