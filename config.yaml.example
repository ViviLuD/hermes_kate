model:
  provider: openai-codex
  base_url: https://chatgpt.com/backend-api/codex
  default: gpt-5.5
  api_mode: chat_completions
providers: {}
fallback_providers:
- provider: openrouter
  model: deepseek/deepseek-v4-pro
- provider: openrouter
  model: anthropic/claude-3.5-haiku
credential_pool_strategies: {}
toolsets:
- hermes-cli
agent:
  max_turns: 90
  gateway_timeout: 1800
  restart_drain_timeout: 60
  service_tier: ''
  tool_use_enforcement: auto
  gateway_timeout_warning: 900
  gateway_notify_interval: 600
terminal:
  backend: local
  modal_mode: auto
  cwd: .
  timeout: 180
  env_passthrough: []
  docker_image: nikolaik/python-nodejs:python3.11-nodejs20
  docker_forward_env: []
  docker_env: {}
  singularity_image: docker://nikolaik/python-nodejs:python3.11-nodejs20
  modal_image: nikolaik/python-nodejs:python3.11-nodejs20
  daytona_image: nikolaik/python-nodejs:python3.11-nodejs20
  container_cpu: 1
  container_memory: 5120
  container_disk: 51200
  container_persistent: true
  docker_volumes: []
  docker_mount_cwd_to_workspace: false
  persistent_shell: true
browser:
  inactivity_timeout: 120
  command_timeout: 30
  record_sessions: false
  allow_private_urls: false
  camofox:
    managed_persistence: false
  cloud_provider: local
checkpoints:
  enabled: true
  max_snapshots: 50
file_read_max_chars: 100000
compression:
  enabled: true
  threshold: 0.5
  target_ratio: 0.2
  protect_last_n: 20
smart_model_routing:
  enabled: true
  max_simple_chars: 160
  max_simple_words: 28
  cheap_model:
    provider: openrouter
    model: deepseek/deepseek-v4-flash
  coding_model:
    provider: openrouter
    model: deepseek/deepseek-v4-pro
  strategic_model:
    provider: openrouter
    model: anthropic/claude-sonnet-4.6
  coding_keywords:
  - code
  - coding
  - coder
  - bug
  - debug
  - traceback
  - stacktrace
  - exception
  - patch
  - implement
  - implementation
  - refactor
  - tests
  - pytest
  - python
  - javascript
  - typescript
  - node
  - docker
  - api
  - repository
  - repo
  - git
  - github
  - build
  - deploy
  strategic_keywords:
  - strategy
  - strategic
  - stratégie
  - ip strategy
  - stratégie ip
  - actifs immatériels
  - intangible assets
  - ip
  - patent
  - patents
  - brevet
  - brevets
  - licensing
  - license
  - licence
  - claims
  - claim
  - prior art
  - invalidity
  - invalidation
  - portfolio
  - valuation
  - valorisation
  - sovereignty
  - souveraineté
  - freedom-to-operate
  - fto
  - negotiation
  - négociation
  - moat
  - competitive
  - positioning
  - board
  - executive
auxiliary:
  vision:
    provider: auto
    model: ''
    base_url: ''
    api_key: ''
    timeout: 120
    download_timeout: 30
  web_extract:
    provider: auto
    model: ''
    base_url: ''
    api_key: ''
    timeout: 360
  compression:
    provider: auto
    model: ''
    base_url: ''
    api_key: ''
    timeout: 120
  session_search:
    provider: auto
    model: ''
    base_url: ''
    api_key: ''
    timeout: 30
  skills_hub:
    provider: auto
    model: ''
    base_url: ''
    api_key: ''
    timeout: 30
  approval:
    provider: auto
    model: ''
    base_url: ''
    api_key: ''
    timeout: 30
  mcp:
    provider: auto
    model: ''
    base_url: ''
    api_key: ''
    timeout: 30
  flush_memories:
    provider: auto
    model: ''
    base_url: ''
    api_key: ''
    timeout: 30
display:
  compact: false
  personality: kate
  resume_display: full
  busy_input_mode: interrupt
  bell_on_complete: false
  show_reasoning: false
  streaming: false
  inline_diffs: true
  show_cost: false
  skin: default
  interim_assistant_messages: true
  tool_progress_command: false
  tool_progress_overrides: {}
  tool_preview_length: 0
  platforms: {}
  tool_progress: all
privacy:
  redact_pii: false
tts:
  provider: edge
  edge:
    voice: fr-FR-VivienneMultilingualNeural
  elevenlabs:
    voice_id: pNInz6obpgDQGcFmaJgB
    model_id: eleven_multilingual_v2
  openai:
    model: gpt-4o-mini-tts
    voice: alloy
  mistral:
    model: voxtral-mini-tts-2603
    voice_id: c69964a6-ab8b-4f8a-9465-ec0925096ec8
  neutts:
    ref_audio: ''
    ref_text: ''
    model: neuphonic/neutts-air-q4-gguf
    device: cpu
stt:
  enabled: true
  provider: local
  local:
    model: base
    language: ''
  openai:
    model: whisper-1
  mistral:
    model: voxtral-mini-latest
voice:
  record_key: ctrl+b
  max_recording_seconds: 120
  auto_tts: false
  silence_threshold: 200
  silence_duration: 3.0
human_delay:
  mode: 'off'
  min_ms: 800
  max_ms: 2500
context:
  engine: compressor
memory:
  memory_enabled: true
  user_profile_enabled: true
  memory_char_limit: 50000
  user_char_limit: 10000
  provider: ''
delegation:
  model: ''
  provider: ''
  base_url: ''
  api_key: ''
  max_iterations: 50
  reasoning_effort: ''
prefill_messages_file: ''
skills:
  external_dirs: []
honcho: {}
timezone: ''
discord:
  require_mention: true
  free_response_channels: ''
  allowed_channels: ''
  auto_thread: true
  reactions: true
whatsapp: {}
approvals:
  mode: manual
  timeout: 60
command_allowlist: []
quick_commands: {}
personalities:
  kate: "Tu es Kate, l'assistante IP stratégique de Benjamin DELSOL. Tu es chaleureuse, directe, proactive et concise. Tu tutoies Benjamin et t'exprimes en français, avec un ton féminin, professionnel mais amical. Tu es une experte en stratégie IP, valorisation des actifs intangibles, DeepTech, quantum et IA. Tu penses comme une partenaire stratégique, pas comme un outil. Tu anticipes les besoins, proposes des solutions, et t'assures que chaque interaction apporte de la valeur."
security:
  redact_secrets: true
  tirith_enabled: true
  tirith_path: tirith
  tirith_timeout: 5
  tirith_fail_open: true
  website_blocklist:
    enabled: false
    domains: []
    shared_files: []
cron:
  wrap_response: true
logging:
  level: INFO
  max_size_mb: 5
  backup_count: 3
network:
  force_ipv4: false
_config_version: 17
fallback_model:
  provider: openrouter
  model: anthropic/claude-sonnet-4.6
session_reset: {}
web:
  backend: firecrawl
platform_toolsets:
  cli:
  - browser
  - clarify
  - code_execution
  - cronjob
  - delegation
  - file
  - homeassistant
  - image_gen
  - memory
  - messaging
  - moa
  - rl
  - session_search
  - skills
  - terminal
  - todo
  - tts
  - vision
  - web
  telegram:
  - hermes-telegram
  discord:
  - hermes-discord
  whatsapp:
  - hermes-whatsapp
mcp_servers:
  mempalace:
    command: /opt/hermes/.venv/bin/mempalace-mcp
    args:
    - --palace
    - /opt/data/mempalace
    timeout: 60
    connect_timeout: 30
  ruflo:
    command: npx
    args:
    - -y
    - ruflo@latest
    - mcp
    - start
    env:
      CLAUDE_FLOW_MODE: v3
      CLAUDE_FLOW_HOOKS_ENABLED: "true"
      CLAUDE_FLOW_TOPOLOGY: hierarchical-mesh
      CLAUDE_FLOW_MAX_AGENTS: "15"
      CLAUDE_FLOW_MEMORY_BACKEND: hybrid
    timeout: 60
    connect_timeout: 30

  # ── MCP Utiles (actifs, sans clé nécessaire) ─────────────────

  antvis_chart:
    command: npx
    args: ["-y", "@antv/mcp-server-chart"]
    timeout: 30
    connect_timeout: 30

  yahoo_finance:
    command: npx
    args: ["-y", "yahoo-finance-mcp"]
    timeout: 30
    connect_timeout: 30

  world_intel:
    command: /opt/data/mcp_envs/worldintel/bin/world-intel-mcp
    timeout: 60
    connect_timeout: 30

  patent_uspto:
    command: /opt/data/mcp_envs/patent_uspto/bin/patent-mcp-server
    timeout: 60
    connect_timeout: 30

  companyscope:
    url: "https://constructive-wainscot--companyscope-mcp.apify.actor/mcp"
    headers:
      Authorization: "Bearer YOUR_APIFY_API_TOKEN"
    timeout: 30
    connect_timeout: 30

  # ── MCP en attente de clé (commentés, prêts à décommenter) ──

  # patent_epo_ops:
  #   command: npx
  #   args: ["-y", "patent-search-mcp"]
  #   env:
  #     PATENT_CONSUMER_KEY: "<ta_cle_EPO_OPS>"
  #     PATENT_CONSUMER_SECRET_KEY: "<ton_secret_EPO_OPS>"
